# Copy this file to .env and paste your keys in. .env is gitignored.
# Nothing here is committed. If you ever see a real key in this file, stop.

# InboxKit: sending domains, mailboxes, DNS, warm-up
# Dashboard > Settings > API
INBOXKIT_API_KEY=

# Enrich.so: the list, email finding, verification
# IMPORTANT: the key works on dev.enrich.so/api/v3, NOT on api.enrich.so
# (api.enrich.so is the old API and wants a JWT, so your key will look broken)
# Dashboard > API Keys. Starts with sk_
ENRICH_API_KEY=

# Instantly: sequences, sending, replies
# Settings > Integrations > API
INSTANTLY_API_KEY=
